# =============================================================================
# ChronoVision — example environment file (PLACEHOLDERS ONLY)
#
# Copy this file to `.env` and replace every CHANGE_ME value before running.
#   cp .env.example .env
#
# `.env` is git-ignored and must never be committed (see .gitignore, SEC-10).
# Placeholder values are intentionally rejected by the configuration validator,
# so the application fails fast instead of starting insecurely.
#
# Generate real secrets with, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=ChronoVision
# One of: development | test | production
ENVIRONMENT=development
DEBUG=false
# One of: CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# --- PostgreSQL (keep in sync with docker-compose.yml) -----------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chronovision
POSTGRES_USER=chronovision
POSTGRES_PASSWORD=CHANGE_ME_generate_a_postgres_password

# --- Security ----------------------------------------------------------------
SECRET_KEY=CHANGE_ME_generate_a_random_48_byte_secret
SESSION_COOKIE_NAME=chronovision_session
SESSION_TTL_SECONDS=86400
# Shared token the vision worker uses to authenticate internal HTTP calls (D-12).
INTERNAL_API_TOKEN=CHANGE_ME_generate_a_random_48_byte_token

# --- Session cookies, CSRF, and login protection (DECISIONS.md D-15, D-16) ---
# Set SESSION_COOKIE_SECURE=true when serving over HTTPS. It is forced to true
# when SESSION_COOKIE_SAMESITE=none. SameSite is one of: lax | strict | none.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=chronovision_csrf
# Failed-login rate limiting: attempts allowed per window, then HTTP 429.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# Minimum length enforced by the create-admin command (D-19).
PASSWORD_MIN_LENGTH=12

# --- Cameras / stream-address policy (DECISIONS.md D-22) ---------------------
# Comma-separated URL schemes accepted for camera stream references. Default is
# RTSP only; http(s), file, ftp, etc. are rejected to prevent SSRF.
CAMERA_ALLOWED_STREAM_SCHEMES=rtsp,rtsps
# Cameras normally live on the local network, so private (RFC1918/ULA) ranges are
# allowed by default. Loopback, link-local, multicast, reserved, unspecified, and
# cloud-metadata addresses are always rejected. Set to false to forbid private ranges.
CAMERA_ALLOW_PRIVATE_NETWORKS=true
# Resolving hostnames at configuration time is subject to DNS rebinding, so it is off
# by default; the authoritative connection-time check (resolve, validate every address,
# pin the IP literal) is performed by the Phase 4 vision worker (D-22, D-28, OQ-14).
CAMERA_RESOLVE_STREAM_HOSTNAMES=false
# A camera still in a processing state whose worker has not reported within this many
# seconds is projected as `disconnected` by read endpoints (D-30).
WORKER_HEARTBEAT_TIMEOUT_SECONDS=15

# --- Vision worker (Phase 4; separate `python -m vision.runtime` process) ------
# The worker reads these VISION_* variables from the same .env files.
# Backend internal API base URL (health/plan channel, D-12/D-29).
VISION_BACKEND_BASE_URL=http://127.0.0.1:8000
# Camera threads per worker process. Phase 4 runs one camera (CON-08); multi-camera
# process isolation is Phase 8.
VISION_MAX_CONCURRENT_CAMERAS=1
# Interval between worker health/state reports (seconds).
VISION_HEARTBEAT_INTERVAL_SECONDS=5
# Bounded per-camera frame queue and detection sampling rate (D-33).
VISION_QUEUE_MAXSIZE=8
VISION_PROCESS_TARGET_FPS=5
# Seconds without a decoded frame before the stream is treated as stalled; bounded
# reconnect uses capped exponential backoff. 0 reconnect attempts = retry indefinitely.
VISION_READ_TIMEOUT_SECONDS=10
VISION_RECONNECT_MAX_ATTEMPTS=0
# Connection-time SSRF mode: `pin` validates and pins the resolved IP literal (recommended,
# D-28). `hostname` keeps the hostname (needed for TLS/SNI or vhosts) and is a documented
# residual; do not use it unless required.
VISION_STREAM_HOST_MODE=pin
# Pretrained detector + tracker (D-32). Weights download lazily on first use and are
# git-ignored; the worker needs the `.[vision]` extra (CPU torch first).
VISION_DETECTOR_WEIGHTS=yolo11n.pt
VISION_DETECTOR_DEVICE=cpu
VISION_DETECTOR_CONFIDENCE=0.25
VISION_DETECTOR_PERSON_ONLY=true
VISION_TRACKER=bytetrack
# Bounded rolling pre-event buffer (FR-35). Leave the frame count unset to derive it from
# EVIDENCE_ROLLING_BUFFER_SECONDS × VISION_PROCESS_TARGET_FPS; the byte cap always applies.
# VISION_ROLLING_BUFFER_FRAMES=75
VISION_ROLLING_BUFFER_MAX_MB=256
# Bounded evidence/handoff queues and spool (Phase 6; D-12/D-43). Overflow is explicit.
VISION_EVIDENCE_ENCODER_QUEUE_MAXSIZE=16
VISION_EVIDENCE_HANDOFF_QUEUE_MAXSIZE=1000
VISION_EVIDENCE_HANDOFF_SPOOL_MAX_MB=5
VISION_EVIDENCE_HANDOFF_MAX_ATTEMPTS=5
VISION_EVIDENCE_HANDOFF_RETRY_BACKOFF_SECONDS=0.5

# --- Evidence (D-11 defaults, confirmed before Phase 6; all configurable) -----
# Leave EVIDENCE_DIR unset to use <repo>/data/evidence.
# EVIDENCE_DIR=/absolute/path/to/data/evidence
# Rolling pre-event buffer window (seconds) used to size the worker buffer (FR-35).
EVIDENCE_ROLLING_BUFFER_SECONDS=15
EVIDENCE_PRE_EVENT_SECONDS=5
EVIDENCE_POST_EVENT_SECONDS=5
# Snapshot on every trigger; a short clip is encoded alongside it (FR-36).
EVIDENCE_SNAPSHOT_ENABLED=true
EVIDENCE_CLIP_FPS=5
# Upper bound on frames retained for one clip (memory guard for the encoder).
EVIDENCE_CLIP_MAX_FRAMES=150
EVIDENCE_RETENTION_DAYS=30
EVIDENCE_STORAGE_LIMIT_GB=25
# Deletion is NEVER an automatic side effect of capture: keep this false and run
# `python -m app.cli prune-evidence` explicitly (or from a scheduled job). Protected
# (pinned) evidence is never removed. See DECISIONS.md D-42/D-43.
EVIDENCE_RETENTION_ON_REGISTER=false

# --- Live playback / MediaMTX gateway (Phase 10; DECISIONS.md D-62..D-65) ------
# Live view is OPT-IN. Deploying MediaMTX alone never enables the dashboard player:
# MEDIAMTX_* URLs without LIVE_PLAYBACK_ENABLED=true is a startup error, not a silent
# activation. Set the URLs and flip the flag to turn the player on.
LIVE_PLAYBACK_ENABLED=false
# Backend -> gateway management API. A trusted INTERNAL service only (never a camera
# address, never browser-visible). With docker-compose `mediamtx` + host networking this
# is http://127.0.0.1:9997; in a bridged network use http://mediamtx:9997.
# Leave BOTH URLs commented out while playback is disabled: setting them without
# LIVE_PLAYBACK_ENABLED=true is rejected at startup. Uncomment them (and set the flag
# above) only when the gateway is actually running.
# MEDIAMTX_API_URL=http://127.0.0.1:9997
# Browser-facing WebRTC (WHEP) base URL. The dashboard calls
# <MEDIAMTX_WEBRTC_URL>/<path>/whep. It MUST be reachable from the operator's browser:
#   - plain HTTP works for http://<host> (WebRTC itself does not need TLS),
#   - use https://<host> when the dashboard is served over HTTPS (mixed-content rule).
# MEDIAMTX_WEBRTC_URL=http://192.168.1.20:8889
# HTTP Basic credentials for the management API (OPTIONAL). The shipped
# deploy/mediamtx.yml grants the Control API anonymously on loopback, which is all the
# backend needs with `network_mode: host`, so leave these EMPTY by default. Only set them
# (and add a matching authInternalUsers user with a real password in deploy/mediamtx.yml)
# when the API is exposed on a non-loopback interface.
MEDIAMTX_API_USERNAME=
MEDIAMTX_API_PASSWORD=
# Generated gateway path names are "<prefix>-cam-<camera_id>" (stable and safe).
MEDIAMTX_PATH_PREFIX=cv
# Management-API request timeout (seconds) and how long the gateway keeps a camera
# connection open after the last viewer leaves (0 = keep it open).
MEDIAMTX_REQUEST_TIMEOUT_SECONDS=2
LIVE_GATEWAY_CLOSE_AFTER_SECONDS=10
# Pin the validated camera IP literal in the gateway source URL so the gateway cannot
# be redirected by a rebinding hostname (recommended). Disable only for cameras that
# need TLS/SNI on the real hostname (documented residual, mirrors VISION_STREAM_HOST_MODE).
LIVE_GATEWAY_PIN_HOSTS=true
